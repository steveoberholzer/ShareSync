@model List<SharePointPermissionSync.Data.Entities.ProcessingJob>

@{
    ViewData["Title"] = "Processing Jobs";
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var pageSize = (int)ViewBag.PageSize;
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h2>Processing Jobs</h2>
                <p>View and manage all job processing operations</p>
            </div>
            <div class="col-auto">
                <a asp-controller="Operations" asp-action="InteractionPermissions" class="btn btn-primary me-2">
                    <i class="bi bi-shield-lock"></i> Sync Permissions
                </a>
                <a asp-controller="Operations" asp-action="InteractionCreation" class="btn btn-outline-primary">
                    <i class="bi bi-folder-plus"></i> Create Interactions
                </a>
            </div>
        </div>
    </div>

    <!-- Filter Buttons -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="btn-group" role="group">
                <a asp-action="Index" class="btn @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-list"></i> All
                </a>
                <a asp-action="Index" asp-route-status="Queued" class="btn @(currentStatus == "Queued" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-clock"></i> Queued
                </a>
                <a asp-action="Index" asp-route-status="Processing" class="btn @(currentStatus == "Processing" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-arrow-repeat"></i> Processing
                </a>
                <a asp-action="Index" asp-route-status="Completed" class="btn @(currentStatus == "Completed" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-check-circle"></i> Completed
                </a>
                <a asp-action="Index" asp-route-status="Failed" class="btn @(currentStatus == "Failed" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-exclamation-triangle"></i> Failed
                </a>
            </div>
        </div>
    </div>

    <!-- Jobs Table -->
    @if (Model.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5>Job List @(!string.IsNullOrEmpty(currentStatus) ? $"- {currentStatus}" : "")</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-modern mb-0">
                        <thead>
                            <tr>
                                <th>Job ID</th>
                                <th>Type</th>
                                <th>File Name</th>
                                <th>Environment</th>
                                <th>Status</th>
                                <th>Progress</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in Model)
                            {
                                var progressPercent = job.TotalItems > 0 ? (int)((decimal)job.ProcessedItems / job.TotalItems * 100) : 0;
                                var statusClass = job.Status switch
                                {
                                    "Completed" => "success",
                                    "Completed with Errors" => "warning",
                                    "Failed" => "danger",
                                    "Processing" => "info",
                                    "Cancelled" => "secondary",
                                    _ => "secondary"
                                };

                                <tr>
                                    <td>
                                        <code>@job.JobId.ToString().Substring(0, 8)</code>
                                    </td>
                                    <td>
                                        @(job.JobType == "InteractionPermissionSync" ? "Permission Sync" :
                                          job.JobType == "InteractionCreation" ? "Creation" :
                                          job.JobType)
                                    </td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@job.FileName">
                                            @job.FileName
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@job.Environment</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@statusClass">@job.Status</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 me-2" style="height: 8px; min-width: 100px;">
                                                <div class="progress-bar bg-@statusClass"
                                                     role="progressbar"
                                                     style="width: @progressPercent%"
                                                     aria-valuenow="@progressPercent"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <small class="text-muted">@job.ProcessedItems/@job.TotalItems</small>
                                        </div>
                                        @if (job.FailedItems > 0)
                                        {
                                            <small class="text-danger">
                                                <i class="bi bi-exclamation-circle"></i> @job.FailedItems failed
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        <small>@job.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@job.JobId" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                <nav aria-label="Job pagination">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-status="@currentStatus" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        </li>
                        <li class="page-item active">
                            <span class="page-link">Page @currentPage</span>
                        </li>
                        <li class="page-item @(Model.Count < pageSize ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-status="@currentStatus" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox icon-lg d-block mb-3 text-muted"></i>
                <h5>No Jobs Found</h5>
                <p class="text-muted">
                    @if (!string.IsNullOrEmpty(currentStatus))
                    {
                        <span>No jobs with status "@currentStatus" found.</span>
                    }
                    else
                    {
                        <span>No processing jobs found. Create a new operation to get started.</span>
                    }
                </p>
                <div class="mt-3">
                    @if (!string.IsNullOrEmpty(currentStatus))
                    {
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left"></i> View All Jobs
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Operations" asp-action="InteractionPermissions" class="btn btn-primary">
                            <i class="bi bi-shield-lock"></i> Sync Permissions
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>
